port := env_var_or_default("PORT", "8080")
# Karate runs on a backend of its own, so a running demo backend is left alone
karate_port := env_var_or_default("KARATE_PORT", "18080")
# Local runs are the demo environment (DD-24), so the demo reset API is on unless DEMO_RESET=0 (DD-29)
demo_reset := env_var_or_default("DEMO_RESET", "1")
pg_db := env_var_or_default("POSTGRES_DB", "carpool")
pg_user := env_var_or_default("POSTGRES_USER", "postgres")
pg_password := env_var_or_default("POSTGRES_PASSWORD", "postgres")
pg_port := env_var_or_default("POSTGRES_PORT", "5432")
db_url := env_var_or_default("DATABASE_URL", "postgres://" + pg_user + ":" + pg_password + "@localhost:" + pg_port + "/" + pg_db + "?sslmode=disable")
run_dir := source_directory() / ".run"
pid_file := run_dir / "server.pid"
log_file := run_dir / "server.log"
# Seconds `up` waits for /api/ping and `down` waits for the process to exit (graceful shutdown takes up to 5 s)
wait_s := "15"

# Build and launch the backend in the background; fails unless /api/ping answers
up:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{source_directory()}}"
    if [ -f "{{pid_file}}" ] && kill -0 "$(cat "{{pid_file}}")" 2>/dev/null; then
        echo "backend already running (pid $(cat "{{pid_file}}"))"
        exit 0
    fi
    for host in 127.0.0.1 ::1; do
        if (: </dev/tcp/$host/{{port}}) 2>/dev/null; then
            echo "error: port {{port}} is already in use by another process (lsof -nP -iTCP:{{port}} -sTCP:LISTEN)" >&2
            exit 1
        fi
    done
    mkdir -p "{{run_dir}}"
    go build -o "{{run_dir}}/server" ./cmd/server
    PORT={{port}} DEMO_RESET={{demo_reset}} nohup "{{run_dir}}/server" >"{{log_file}}" 2>&1 &
    pid=$!
    echo $pid > "{{pid_file}}"
    for _ in $(seq $(({{wait_s}} * 5))); do
        if curl -sf http://localhost:{{port}}/api/ping >/dev/null; then
            echo "backend started on :{{port}} (pid $pid, log {{log_file}}, DEMO_RESET={{demo_reset}})"
            exit 0
        fi
        kill -0 $pid 2>/dev/null || break
        sleep 0.2
    done
    echo "error: backend did not answer /api/ping on :{{port}}; last lines of {{log_file}}:" >&2
    tail -n 20 "{{log_file}}" >&2
    kill $pid 2>/dev/null || true
    rm -f "{{pid_file}}"
    exit 1

# Stop the backend started by `up` and wait until it has exited
down:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -f "{{pid_file}}" ]; then
        echo "backend not running"
        exit 0
    fi
    pid=$(cat "{{pid_file}}")
    if ! kill -0 "$pid" 2>/dev/null; then
        echo "backend not running (stale pid file)"
        rm -f "{{pid_file}}"
        exit 0
    fi
    kill "$pid"
    for _ in $(seq $(({{wait_s}} * 5))); do
        if ! kill -0 "$pid" 2>/dev/null; then
            rm -f "{{pid_file}}"
            echo "backend stopped (pid $pid)"
            exit 0
        fi
        sleep 0.2
    done
    echo "error: backend (pid $pid) did not exit within {{wait_s}} s; stop it with: kill -9 $pid" >&2
    exit 1

# Run the Go unit tests (needs `just infra up` and `db-apply`)
test:
    cd "{{source_directory()}}" && go test ./...

# Run the Karate API tests on a backend of their own on KARATE_PORT, with simulated routes and the demo reset on, leaving a running demo backend alone (needs `just infra up` and `db-apply`)
karate:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{source_directory()}}"
    mkdir -p "{{run_dir}}"
    go build -o "{{run_dir}}/karate-server" ./cmd/server
    # Tests never call the real Google Routes: an empty MAP_API_KEY wins over the one in .env
    PORT={{karate_port}} DEMO_RESET=1 MAP_API_KEY= "{{run_dir}}/karate-server" >"{{run_dir}}/karate-server.log" 2>&1 &
    pid=$!
    trap 'kill $pid 2>/dev/null || true' EXIT
    for _ in $(seq 50); do
        curl -sf http://localhost:{{karate_port}}/api/ping >/dev/null && break
        kill -0 $pid 2>/dev/null || { cat "{{run_dir}}/karate-server.log"; exit 1; }
        sleep 0.2
    done
    cd karate && mvn -q test -DbaseUrl=http://localhost:{{karate_port}} -DdbUrl=jdbc:postgresql://localhost:{{pg_port}}/{{pg_db}}

# Apply all pending migrations (needs `just infra up`)
db-apply:
    cd "{{source_directory()}}" && GOOSE_DRIVER=postgres GOOSE_DBSTRING="{{db_url}}" GOOSE_MIGRATION_DIR=migrations go tool goose up

# Roll back the most recently applied migration
db-rollback:
    cd "{{source_directory()}}" && GOOSE_DRIVER=postgres GOOSE_DBSTRING="{{db_url}}" GOOSE_MIGRATION_DIR=migrations go tool goose down

# Show which migrations are applied
migrate-status:
    cd "{{source_directory()}}" && GOOSE_DRIVER=postgres GOOSE_DBSTRING="{{db_url}}" GOOSE_MIGRATION_DIR=migrations go tool goose status

# Create a new SQL migration, e.g. `just backend migrate-new create_trips`
migrate-new name:
    cd "{{source_directory()}}" && go tool goose -dir migrations create {{name}} sql

# Wipe the public schema and re-apply every migration (test data is disposable)
db-reset:
    docker compose -f "{{source_directory()}}/../docker-compose.yml" exec -T postgres psql -v ON_ERROR_STOP=1 -U {{pg_user}} -d {{pg_db}} -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;'
    just --justfile "{{source_directory()}}/justfile" db-apply
