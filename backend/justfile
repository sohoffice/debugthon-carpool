port := env_var_or_default("PORT", "8080")
run_dir := source_directory() / ".run"
pid_file := run_dir / "server.pid"
log_file := run_dir / "server.log"

# Build and launch the backend in the background
up:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{source_directory()}}"
    if [ -f "{{pid_file}}" ] && kill -0 "$(cat "{{pid_file}}")" 2>/dev/null; then
        echo "backend already running (pid $(cat "{{pid_file}}"))"
        exit 0
    fi
    mkdir -p "{{run_dir}}"
    go build -o "{{run_dir}}/server" ./cmd/server
    PORT={{port}} nohup "{{run_dir}}/server" >"{{log_file}}" 2>&1 &
    echo $! > "{{pid_file}}"
    echo "backend started on :{{port}} (pid $!, log {{log_file}})"

# Stop the backend started by `up`
down:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -f "{{pid_file}}" ]; then
        echo "backend not running"
        exit 0
    fi
    pid=$(cat "{{pid_file}}")
    if kill -0 "$pid" 2>/dev/null; then
        kill "$pid"
        echo "backend stopped (pid $pid)"
    else
        echo "backend not running (stale pid file)"
    fi
    rm -f "{{pid_file}}"
