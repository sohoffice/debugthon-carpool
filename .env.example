TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
MAP_API_KEY=

# --- UI（Vite 讀取此根目錄 .env）---
# 瀏覽器用金鑰：會公開給使用者。請限制為 HTTP 參照網址 + 只開 Maps JavaScript API。
# 不要重複使用伺服器端的 MAP_API_KEY。
VITE_GOOGLE_MAPS_API_KEY=
# 選填。留空則使用 Google 的 DEMO_MAP_ID。
VITE_GOOGLE_MAPS_MAP_ID=
# 選填。開發時 /api 轉送的目標（預設 http://localhost:8080）。
API_PROXY_TARGET=
