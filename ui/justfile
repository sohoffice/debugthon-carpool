mock_url := "http://localhost:8081"
backend_url := "http://localhost:8080"

# Install npm dependencies for all UI workspaces
install:
    cd "{{source_directory()}}" && npm install

# Start the driver UI dev server on :5173
driver:
    cd "{{source_directory()}}" && npm run dev:driver

# Start the passenger UI dev server on :5174
passenger:
    cd "{{source_directory()}}" && npm run dev:passenger

# Start the city dashboard on :5175 (DD-39); open it with ?account=city1
city:
    cd "{{source_directory()}}" && npm run dev:city

# Start the showcase page on :5170 (UD-18); it embeds the driver and passenger UIs
showcase:
    cd "{{source_directory()}}" && npm run dev:showcase

# Start the mock backend, both UIs, the showcase page and the city dashboard against it (development, UD-14)
dev-mock:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{source_directory()}}"
    trap 'kill 0' EXIT
    npm run mock &
    API_PROXY_TARGET={{mock_url}} npm run dev:driver &
    API_PROXY_TARGET={{mock_url}} npm run dev:passenger &
    API_PROXY_TARGET={{mock_url}} npm run dev:showcase &
    API_PROXY_TARGET={{mock_url}} npm run dev:city &
    wait

# Start both UIs, the showcase page and the city dashboard against the Go backend on :8080 (start it with `just backend up`)
dev:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{source_directory()}}"
    trap 'kill 0' EXIT
    API_PROXY_TARGET={{backend_url}} npm run dev:driver &
    API_PROXY_TARGET={{backend_url}} npm run dev:passenger &
    API_PROXY_TARGET={{backend_url}} npm run dev:showcase &
    API_PROXY_TARGET={{backend_url}} npm run dev:city &
    wait

# Start only the mock backend on :8081
mock:
    cd "{{source_directory()}}" && npm run mock

# Switch the mock scenario and reset: normal, reassign, no_cars
mock-scenario name:
    @curl -sf -X POST -H 'Content-Type: application/json' -d '{"scenario":"{{name}}"}' {{mock_url}}/api/_mock/scenario && echo

# Move the mock clock forward, e.g. to reach the destination
mock-advance seconds:
    @curl -sf -X POST -H 'Content-Type: application/json' -d '{"seconds":{{seconds}}}' {{mock_url}}/api/_mock/advance && echo

# Reset the mock to its initial state (same API as the Go backend)
mock-reset:
    @curl -sf -X POST {{mock_url}}/api/demo/reset && echo reset

# Typecheck and run all UI tests
test:
    cd "{{source_directory()}}" && npm run typecheck && npm test

# Run the UI end-to-end tests (Playwright) on their own mock backend and apps (T18B)
e2e:
    cd "{{source_directory()}}" && npx playwright install chromium && npx playwright test

# Run the UI end-to-end tests on the Go backend with a database of its own (T18B; needs `just infra up`)
e2e-go:
    cd "{{source_directory()}}" && npx playwright install chromium && npx playwright test -c playwright.go.config.ts

# Build the static site (portal at the root, showcase.html beside it, apps in folders, mock backend in the browser) into static-site/dist
static-build:
    cd "{{source_directory()}}" && node static-site/build.ts

# Build the static site and run its end-to-end tests (Playwright) on it, served under the bucket's sub-path (T68)
static-e2e: static-build
    cd "{{source_directory()}}" && npx playwright install chromium && npx playwright test -c static-site/playwright.config.ts

# Upload the static site to a public GCS bucket (created on first run) in the active gcloud project
static-deploy bucket="carpool-neihu-static" location="asia-east1": static-build
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{source_directory()}}"
    if ! gcloud storage buckets describe "gs://{{bucket}}" >/dev/null 2>&1; then
        gcloud storage buckets create "gs://{{bucket}}" --location={{location}} --uniform-bucket-level-access
        gcloud storage buckets add-iam-policy-binding "gs://{{bucket}}" --member=allUsers --role=roles/storage.objectViewer
    fi
    gcloud storage rsync static-site/dist "gs://{{bucket}}" --recursive --delete-unmatched-destination-objects
    # Pages change on every deploy; hashed assets never do
    gcloud storage objects update "gs://{{bucket}}/**.html" --cache-control=no-cache
    echo "site: https://storage.googleapis.com/{{bucket}}/index.html"
