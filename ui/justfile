mock_url := "http://localhost:8081"
backend_url := "http://localhost:8080"

# Install npm dependencies for all UI workspaces
install:
    cd "{{source_directory()}}" && npm install

# Start the driver UI dev server on :5173
driver:
    cd "{{source_directory()}}" && npm run dev:driver

# Start the passenger UI dev server on :5174
passenger:
    cd "{{source_directory()}}" && npm run dev:passenger

# Start the showcase page on :5170 (UD-18); it embeds the driver and passenger UIs
showcase:
    cd "{{source_directory()}}" && npm run dev:showcase

# Start the mock backend, both UIs and the showcase page against it (development, UD-14)
dev-mock:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{source_directory()}}"
    trap 'kill 0' EXIT
    npm run mock &
    API_PROXY_TARGET={{mock_url}} npm run dev:driver &
    API_PROXY_TARGET={{mock_url}} npm run dev:passenger &
    API_PROXY_TARGET={{mock_url}} npm run dev:showcase &
    wait

# Start both UIs and the showcase page against the Go backend on :8080 (start it with `just backend up`)
dev:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{source_directory()}}"
    trap 'kill 0' EXIT
    API_PROXY_TARGET={{backend_url}} npm run dev:driver &
    API_PROXY_TARGET={{backend_url}} npm run dev:passenger &
    API_PROXY_TARGET={{backend_url}} npm run dev:showcase &
    wait

# Start only the mock backend on :8081
mock:
    cd "{{source_directory()}}" && npm run mock

# Switch the mock scenario and reset: normal, reassign, no_cars
mock-scenario name:
    @curl -sf -X POST -H 'Content-Type: application/json' -d '{"scenario":"{{name}}"}' {{mock_url}}/api/_mock/scenario && echo

# Move the mock clock forward, e.g. to reach the destination
mock-advance seconds:
    @curl -sf -X POST -H 'Content-Type: application/json' -d '{"seconds":{{seconds}}}' {{mock_url}}/api/_mock/advance && echo

# Reset the mock to its initial state (same API as the Go backend)
mock-reset:
    @curl -sf -X POST {{mock_url}}/api/demo/reset && echo reset

# Typecheck and run all UI tests
test:
    cd "{{source_directory()}}" && npm run typecheck && npm test

# Run the UI end-to-end tests (Playwright) on their own mock backend and apps (T18B)
e2e:
    cd "{{source_directory()}}" && npx playwright install chromium && npx playwright test

# Run the UI end-to-end tests on the Go backend with a database of its own (T18B; needs `just infra up`)
e2e-go:
    cd "{{source_directory()}}" && npx playwright install chromium && npx playwright test -c playwright.go.config.ts
