{
  "name": "carpool-ui",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "driver",
    "passenger",
    "showcase",
    "city"
  ],
  "scripts": {
    "dev:driver": "npm run dev -w driver",
    "dev:passenger": "npm run dev -w passenger",
    "build": "npm run build -w driver -w passenger -w showcase -w city",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "mock": "node mock-server/src/main.ts",
    "dev:showcase": "npm run dev -w showcase",
    "dev:city": "npm run dev -w city"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/google.maps": "^3.66.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
